      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/*.env.*)",
      "Read(./.envrc)",
      "Read(**/.envrc)",
      "Read(./secrets/**)",
      "Read(**/secrets/**)",
      "Read(**/secrets*)",
      "Read(**/secret*)",
      "Read(**/license.dat)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.crt)",
      "Read(**/*.cer)",
      "Read(**/*.der)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.mobileprovision)",
      "Read(**/*.asc)",
      "Read(**/*.gpg)",
      "Read(**/*.tfstate*)",
      "Read(**/id_*)",
      "Read(**/credentials)",
      "Read(**/credentials.*)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/.gnupg/**)",
