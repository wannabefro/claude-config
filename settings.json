      "Bash(killall *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(git clean *)",
      "Bash(git reset *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "worktree": {
    "_baseRef_note": "'fresh' (the default) branches agent worktrees from origin/<default-branch>. This repo routinely sits many commits ahead of origin \u2014 pushing needs explicit direction \u2014 so on 2026-07-27 a /build fan-out branched every unit from a 23-commit-stale origin/main, edited files as they existed two weeks ago, and still went green because each unit's verify only checked its own file. Merging would have reverted the day's work. 'head' branches from local HEAD instead, so agents see committed-but-unpushed state.",
    "baseRef": "head"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash __CLAUDE_HOME__/hooks/offer-build-after-plan.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash __CLAUDE_HOME__/hooks/verify-on-edit-async.sh",
            "timeout": 45,
            "async": true
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "bash __CLAUDE_HOME__/hooks/worktree-rebase.sh"
          },
          {
            "type": "command",
            "command": "bash __CLAUDE_HOME__/hooks/worktree-codegraph.sh",
            "timeout": 180,
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": []
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash __CLAUDE_HOME__/hooks/bash-safety.sh"
          },
          {
            "type": "command",
            "command": "bash __CLAUDE_HOME__/hooks/commit-precheck.sh"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "bash __CLAUDE_HOME__/hooks/pr-guardrail-review.sh",
            "if": "Bash(gh pr *)",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/pr-explain-nudge.sh\""
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "bash __CLAUDE_HOME__/hooks/worktree-fetch.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Read|NotebookEdit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/worktree-boundary.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/context-mode-cache-heal.mjs",
            "args": []
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash __CLAUDE_HOME__/statusline.sh",
    "padding": 1
  },
